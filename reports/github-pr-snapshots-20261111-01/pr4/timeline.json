[{"sha":"36366012d8938d4b884c9738853a45d3a7f2168f","node_id":"C_kwDOU0OAK9oAKDM2MzY2MDEyZDg5MzhkNGI4ODRjOTczODg1M2E0NWQzYTdmMjE2OGY","url":"https://api.github.com/repos/rafli-hl/sequence-weighting-research/git/commits/36366012d8938d4b884c9738853a45d3a7f2168f","html_url":"https://github.com/rafli-hl/sequence-weighting-research/commit/36366012d8938d4b884c9738853a45d3a7f2168f","author":{"name":"Claude","email":"noreply@anthropic.com","date":"2026-11-04T06:03:24Z"},"committer":{"name":"Claude","email":"noreply@anthropic.com","date":"2026-11-04T06:03:24Z"},"tree":{"sha":"19ba952010a854c538be2c10c2015f594f9b4f99","url":"https://api.github.com/repos/rafli-hl/sequence-weighting-research/git/trees/19ba952010a854c538be2c10c2015f594f9b4f99"},"message":"Publish the natural-text studies, the adversarial review and its response\n\nAdd 248 files from the synthetic follow-up (S) and the natural-text\nstudies (N1, N3-N6) at their historical relative paths, byte-identical\nto their local sources: sealed source packages and protocols, results,\nanalysis tables, seed registries, the two failure reports, both evidence\nchains, the adversarial review with its recomputations, the response\nwith the final claims (section 5), and the owner's design decisions.\n\nNATURAL_TEXT_STUDIES.md indexes them and states the scope: a small-scale\nmethodological study of p*, not a replication of Jane Street's findings.\nREADME, PUBLICATION_NOTES and DATA_AVAILABILITY describe the addition\nand its one exception (owner decisions are included). The manifest rows\nfor changed files are updated in place and new rows appended, keeping\nthe original order and CRLF line endings. No experiment was rerun.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01JvfaYmnEddgunH3yg39Yo4","parents":[{"sha":"58240f0e0e86a8d5514267c80ac7c30f19fb4076","url":"https://api.github.com/repos/rafli-hl/sequence-weighting-research/git/commits/58240f0e0e86a8d5514267c80ac7c30f19fb4076","html_url":"https://github.com/rafli-hl/sequence-weighting-research/commit/58240f0e0e86a8d5514267c80ac7c30f19fb4076"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgrLzsfFISF4by8Q+FKz27YpkK1USsBB+m\namu1QkJnbDsAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5AAAAQMjT4MqS\nfriqkYDWzZ18MsLTaohpopn9hRWORZmpcoIJ3XIRNWROnVUG9jdzGs8h+QJ0/ZplAKlPJf4E4akY\nSw0=\n-----END SSH SIGNATURE-----","payload":"tree 19ba952010a854c538be2c10c2015f594f9b4f99\nparent 58240f0e0e86a8d5514267c80ac7c30f19fb4076\nauthor Claude <noreply@anthropic.com> 1793772204 +0700\ncommitter Claude <noreply@anthropic.com> 1793772204 +0700\n\nPublish the natural-text studies, the adversarial review and its response\n\nAdd 248 files from the synthetic follow-up (S) and the natural-text\nstudies (N1, N3-N6) at their historical relative paths, byte-identical\nto their local sources: sealed source packages and protocols, results,\nanalysis tables, seed registries, the two failure reports, both evidence\nchains, the adversarial review with its recomputations, the response\nwith the final claims (section 5), and the owner's design decisions.\n\nNATURAL_TEXT_STUDIES.md indexes them and states the scope: a small-scale\nmethodological study of p*, not a replication of Jane Street's findings.\nREADME, PUBLICATION_NOTES and DATA_AVAILABILITY describe the addition\nand its one exception (owner decisions are included). The manifest rows\nfor changed files are updated in place and new rows appended, keeping\nthe original order and CRLF line endings. No experiment was rerun.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01JvfaYmnEddgunH3yg39Yo4\n","verified_at":"2026-11-04T06:03:28Z"},"event":"committed"},{"url":"https://api.github.com/repos/rafli-hl/sequence-weighting-research/issues/comments/6623878408","html_url":"https://github.com/rafli-hl/sequence-weigh